def play_music(path):
    try:
        songs = [file for file in os.listdir(path) if file.endswith(('.mp3', '.wav'))]
        if songs:
            song = random.choice(songs)
            full_path = os.path.join(path, song)
            speak(f"Playing {song}")
            os.startfile(full_path)
        else:
            speak("No music files found in the folder.")
    except Exception as e:
        speak("Failed to play music.")
        print("Error:", e)


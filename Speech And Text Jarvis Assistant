def system_control(command: str) -> bool:
    """
    Perform basic system-level volume controls.
    Works for Windows, macOS (Darwin), and Linux.
    Supported commands: mute, unmute, volume up, volume down
    """
    try:
        if not command:
            return False

        command = command.strip().lower()
        system_name = platform.system()

        # 🎯 Windows
        if system_name == "Windows":
            actions = {
                "mute": lambda: keyboard.press_and_release("volume mute"),
                "unmute": lambda: keyboard.press_and_release("volume mute"),  # toggle
                "volume up": lambda: keyboard.press_and_release("volume up"),
                "volume down": lambda: keyboard.press_and_release("volume down"),
            }

        # 🎯 macOS (Darwin)
        elif system_name == "Darwin":
            actions = {
                "mute": lambda: os.system("osascript -e 'set volume output muted true'"),
                "unmute": lambda: os.system("osascript -e 'set volume output muted false'"),
                "volume up": lambda: os.system("osascript -e 'set volume output volume ((output volume of (get volume settings)) + 10)'"),
                "volume down": lambda: os.system("osascript -e 'set volume output volume ((output volume of (get volume settings)) - 10)'"),
            }

        # 🎯 Linux
        else:  
            actions = {
                "mute": lambda: os.system("amixer -D pulse sset Master mute || pactl set-sink-mute @DEFAULT_SINK@ 1"),
                "unmute": lambda: os.system("amixer -D pulse sset Master unmute || pactl set-sink-mute @DEFAULT_SINK@ 0"),
                "volume up": lambda: os.system("amixer -D pulse sset Master 5%+ || pactl set-sink-volume @DEFAULT_SINK@ +5%"),
                "volume down": lambda: os.system("amixer -D pulse sset Master 5%- || pactl set-sink-volume @DEFAULT_SINK@ -5%"),
            }

        # 🔊 Execute command
        if command in actions:
            print(f"🔊 Performing system command: {command}")
            actions[command]()
            return True
        else:
            print(f"⚠️ Unknown system command: {command}")
            return False

    except Exception as e:
        logging.error(f"system_control error: {e}")
        return False



# ========== Reminder Manager ==========
class ReminderManager:
    def __init__(self):
        self.reminders = {}

    def add_reminder(self, command):
        time_str, message = self.extract_time_and_message(command)
        if not time_str or not message:
            return "⚠️ Could not understand reminder time or message."

        self.reminders[time_str] = message
        schedule.every().day.at(time_str).do(self._trigger_reminder, message)
        speak(f"⏰ Reminder set for {time_str}: {message}")
        return f"✅ Reminder added: {message} at {time_str}"

    def extract_time_and_message(self, text):
        # Detect time in format like 5:30, 17:30, 5:30 PM, etc.
        match = re.search(r'(\d{1,2}):(\d{2})\s*(am|pm|AM|PM)?', text)
        if not match:
            return None, None

        hour, minute, meridian = match.groups()
        hour, minute = int(hour), int(minute)

        if meridian:
            if meridian.lower() == "pm" and hour != 12:
                hour += 12
            elif meridian.lower() == "am" and hour == 12:
                hour = 0

        time_str = f"{hour:02d}:{minute:02d}"

        # Remove time part from message
        message = re.sub(r'(\d{1,2}):(\d{2})\s*(am|pm|AM|PM)?', '', text, flags=re.IGNORECASE).strip()
        message = message.replace("remind me to", "").replace("remind me", "").strip()

        return time_str, message

    def _trigger_reminder(self, message):
        print(f"🔔 Reminder Alert: {message}")
        show_notification("🔔 Reminder", message)
        speak(f"Reminder: {message}")

    def run_scheduler(self):
        def loop():
            while True:
                schedule.run_pending()
                time.sleep(1)
        Thread(target=loop, daemon=True).start()
    

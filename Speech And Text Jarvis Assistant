import speech_recognition as sr

def speechtotext():
    """
    Takes user input by typing (keyboard) or speaking (voice).
    Returns recognized text as a string.
    """
    r = sr.Recognizer()
    try:
        mode = input("📌 Choose mode: (t = type, v = voice) : ").strip().lower()

        if mode == "t":
            user_input = input("⌨ Type your command: ").strip().lower()
            
        elif mode == "v":
            with sr.Microphone() as source:
                print("🎤 Listening...")
                r.adjust_for_ambient_noise(source, duration=1)
                r.pause_threshold = 1
                audio = r.listen(source)

            try:
                user_input = r.recognize_google(audio, language="en-in").lower()
                print(f"✅ You said: {user_input}")
            except sr.UnknownValueError:
                print("⚠️ Could not understand, please try again.")
                return ""
            except sr.RequestError:
                print("❌ Network error, please check your internet.")
                return ""
        else:
            print("⚠️ Invalid choice. Please choose 't' or 'v'.")
            return ""

        # Exit command check (for both modes)
        if user_input in ["exit", "jarvis shutdown", "stop", "band ho ja"]:
            speak("Goodbye sir, see you soon.")
            return "exit"

        return user_input

    except Exception as e:
        print("⚠️ Error in speechtotext:", e)
        return ""

            
